# Optional endpoint for the contact form (accepts multipart/form-data POST)
NEXT_PUBLIC_FORM_ENDPOINT=

# Sanity.io CMS configuration (project pls29s2l / dataset production)
NEXT_PUBLIC_SANITY_PROJECT_ID=pls29s2l
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Optional read token (server-only) if dataset visibility is changed to private
SANITY_API_READ_TOKEN=

# Bandsintown: official widget for the home "Shows" list (app id from your Bandsintown account)
NEXT_PUBLIC_BANDSINTOWN_APP_ID=
# Optional: Bandsintown artist id (defaults to 15622702)
NEXT_PUBLIC_BANDSINTOWN_ARTIST_ID=15622702

# Optional direct Fourthwall preview/product URLs for Selected Work cards.
# Until these are supplied, Juno and Alder continue to open their local project pages.
NEXT_PUBLIC_FOURTHWALL_JUNO_URL=
NEXT_PUBLIC_FOURTHWALL_ALDER_URL=
