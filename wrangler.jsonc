{
  // Cloudflare Workers static assets / Pages: deploy the exported site.
  "name": "website-valerieskyler",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./out" },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
